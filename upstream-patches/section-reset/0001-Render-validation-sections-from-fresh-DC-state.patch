 """Renders the test-signal pack through a SPICE netlist with ngspice, producing a reference capture.
 
 The pack is upsampled 4x, split into sections (each with its trailing gap) that run in parallel from
-the circuit's DC operating point, then stitched and decimated. Sections are separated by silence
-longer than the circuit's settling time, so this matches one continuous run.
+the circuit's DC operating point, then stitched and decimated. Each section starts from DC, not the
+state left by the preceding section; a continuous run may differ for slowly settling circuits.
 """
 
 import multiprocessing
diff --git a/template/harness/tests/test_harness.py b/template/harness/tests/test_harness.py
index 78cce63..aa0822c 100644
--- a/template/harness/tests/test_harness.py
+++ b/template/harness/tests/test_harness.py
@@ -114,3 +114,69 @@ def test_spice_reference_matches_analytic_rc(tmp_path):
     f = np.array(fr["freqs"])
     expected = -10 * np.log10(1 + (2 * np.pi * f * 1000 * 10e-9) ** 2)
     assert np.max(np.abs(np.array(fr["db"]) - expected)) < 0.01
+
+
+def test_model_sections_restart_with_trailing_gap(tmp_path):
+    """A long-lived accumulator must not carry its previous charge into the next section."""
+    from analog_harness import cli
+
+    renderer = tmp_path / "render"
+    renderer.write_text(
+        "#!/usr/bin/env python3\nimport sys\nimport numpy as np\nimport soundfile as sf\n"
+        "x, fs = sf.read(sys.argv[1])\n"
+        "sf.write(sys.argv[2], np.cumsum(x), fs, subtype='FLOAT')\n"
+    )
+    renderer.chmod(0o755)
+    x = np.array([0, 1, 1, 0, 0, 2, 2, 0, 0], dtype=float)
+    manifest = {"sample_rate": 4, "sections": [{"start": 1, "length": 2}, {"start": 5, "length": 2}]}
+    y = cli.render_sections(x, manifest, [], renderer)
+    np.testing.assert_array_equal(y, [0, 1, 2, 2, 2, 2, 4, 4, 4])
+
+
+def test_overlapping_section_spans_are_overwritten_in_manifest_order(tmp_path):
+    from analog_harness import cli
+
+    renderer = tmp_path / "render"
+    renderer.write_text(
+        "#!/usr/bin/env python3\nimport sys\nimport numpy as np\nimport soundfile as sf\n"
+        "x, fs = sf.read(sys.argv[1])\n"
+        "sf.write(sys.argv[2], np.cumsum(x), fs, subtype='FLOAT')\n"
+    )
+    renderer.chmod(0o755)
+    x = np.ones(7)
+    manifest = {"sample_rate": 4, "sections": [{"start": 0, "length": 3}, {"start": 3, "length": 2}]}
+    np.testing.assert_array_equal(cli.render_sections(x, manifest, [], renderer), [1, 2, 3, 1, 2, 3, 4])
+
+
+def test_real_model_section_equals_isolated_render(tmp_path):
+    import os
+    import subprocess
+
+    import soundfile as sf
+
+    from analog_harness import cli
+
+    repo = cli.REPO
+    env = {**os.environ, "CARGO_TARGET_DIR": str(repo / "target")}
+    subprocess.run(["cargo", "build", "--quiet", "--release", "-p", "render"], cwd=repo, env=env, check=True)
+    executable = repo / "target/release/render"
+    fs = 48_000
+    first = np.full(fs // 5, 0.8, dtype=np.float32)
+    gap = np.zeros(fs // 2, dtype=np.float32)
+    second = signals.tone(fs, 1000, 0.1, -30).astype(np.float32)
+    x = np.concatenate([first, gap, second, gap])
+    start = len(first) + len(gap)
+    manifest = {
+        "sample_rate": fs,
+        "sections": [{"start": 0, "length": len(first)}, {"start": start, "length": len(second)}],
+    }
+    y = cli.render_sections(x, manifest, [], executable)
+    src, dst = tmp_path / "in.wav", tmp_path / "out.wav"
+    sf.write(src, x[start:], fs, subtype="FLOAT")
+    subprocess.run([str(executable), str(src), str(dst)], check=True)
+    isolated, _ = sf.read(dst)
+    np.testing.assert_array_equal(y[start:], isolated)
+    sf.write(src, x, fs, subtype="FLOAT")
+    subprocess.run([str(executable), str(src), str(dst)], check=True)
+    continuous, _ = sf.read(dst)
+    assert np.max(np.abs(continuous[start:] - isolated)) > 1e-8
