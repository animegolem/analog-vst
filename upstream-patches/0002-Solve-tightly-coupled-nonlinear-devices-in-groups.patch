+    #[test]
+    fn antiparallel_diodes_do_not_force_independent_follower_joint() {
+        let c = Circuit::new(
+            vec![
+                Element::Input(1, 0),
+                Element::Resistor(1, 2, 10e3),
+                Element::Diode {
+                    a: 2,
+                    b: 0,
+                    is: 1e-14,
+                    nvt: 0.025,
+                },
+                Element::Diode {
+                    a: 0,
+                    b: 2,
+                    is: 1e-14,
+                    nvt: 0.025,
+                },
+                Element::Dc(3, 0, 9.0),
+                Element::Resistor(3, 4, 10e3),
+                Element::Resistor(4, 0, 10e3),
+                Element::Resistor(5, 0, 10e3),
+                Element::Npn {
+                    c: 3,
+                    b: 4,
+                    e: 5,
+                    model: Q2N3904,
+                },
+            ],
+            (2, 0),
+            96_000.0,
+        );
+        assert_eq!(c.groups.iter().map(|g| g.len()).collect::<Vec<_>>(), vec![2, 1]);
+        let mut grouped = c.clone();
+        let mut full = c;
+        full.groups = vec![0..full.devices.len()];
+        full.group_ports = vec![full
+            .devices
+            .iter()
+            .flat_map(|(dev, first)| *first..*first + dev.ports())
+            .collect()];
+        full.sequential = true;
+        for t in 0..2000 {
+            let input = 0.7 * (t as f64 * 0.037).sin();
+            let a = grouped.tick(input);
+            let b = full.tick(input);
+            assert!((a - b).abs() < 1e-9, "sample {t}: {a} vs {b}");
+            for (a, b) in grouped.v.iter().zip(&full.v) {
+                assert!((a - b).abs() < 1e-9, "sample {t}: port {a} vs {b}");
+            }
+        }
+    }
